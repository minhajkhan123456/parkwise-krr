digraph G { graph [rankdir=TB,bgcolor="transparent",pad=.2,nodesep=.28,ranksep=.5]; node [shape=box,style="rounded,filled",fillcolor="#eaf5f2",color="#61a99c",fontname="DejaVu Sans",fontsize=10,margin=".14,.1"]; edge [color="#567181",fontname="DejaVu Sans",fontsize=8,arrowsize=.65];
start [label="Request submitted",shape=oval];valid [label="Input valid?",shape=diamond];err [label="Show input error",fillcolor="#fbe7e4"];derive [label="Build facts and run both engines"];agree [label="Results agree?",shape=diamond];stop [label="Stop on engine discrepancy",fillcolor="#fbe7e4"];exists [label="Any candidate?",shape=diamond];deny [label="Explain failed conditions",fillcolor="#fff1d7"];rank [label="Sort by distance, cost, ID"];confirm [label="User confirms?",shape=diamond];save [label="Re-evaluate latest state
then save one booking"];show [label="Display options and proof"];start -> valid;valid -> err [label="no"];valid -> derive [label="yes"];derive -> agree;agree -> stop [label="no"];agree -> exists [label="yes"];exists -> deny [label="no"];exists -> rank [label="yes"];rank -> show;show -> confirm;confirm -> save [label="yes"];
}