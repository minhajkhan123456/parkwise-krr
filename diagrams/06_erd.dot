digraph G { graph [rankdir=TB,bgcolor="transparent",pad=.2,nodesep=.28,ranksep=.5]; node [shape=box,style="rounded,filled",fillcolor="#eaf5f2",color="#61a99c",fontname="DejaVu Sans",fontsize=10,margin=".14,.1"]; edge [color="#567181",fontname="DejaVu Sans",fontsize=8,arrowsize=.65];
node [shape=record,style=filled]; facility [label="{Facility|name|opens / closes}"];zone [label="{Zone|name|level}"];bay [label="{Bay|id (PK)|kind / zone / rate|height / width / max_minutes|open / sensor / charger}"];req [label="{Request|id (session key)|vehicle / dimensions|start / end / budget|verified / enabled / badge / charge}"];booking [label="{Booking|id (unique)|bay (FK)|request snapshot}"];policy [label="{RuleSchema|id (PK)|scope / head / body}"];evidence [label="{Evidence|snapshot|facts / closure / proofs}"];
facility -> zone [label="1 to many"];zone -> bay [label="1 to many"];req -> booking [label="0..1 confirmation"];bay -> booking [label="1 to many over time"];req -> evidence [label="1 to many evaluations"];policy -> evidence [label="grounds into"];
